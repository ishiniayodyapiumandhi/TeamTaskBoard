rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function canComment(taskId) {
      let access = get(/databases/$(database)/documents/taskAccess/$(taskId));
      return request.auth != null
        && access.data.ownerUid == request.auth.uid
        && access.data.expiresAt > request.time;
    }

    match /taskAccess/{taskId}/comments/{commentId} {
      allow get: if canComment(taskId);
      allow list: if canComment(taskId) && request.query.limit <= 100;
      allow create: if canComment(taskId)
        && request.resource.data.keys().hasAll(['text', 'authorUid', 'createdAt'])
        && request.resource.data.keys().hasOnly(['text', 'authorUid', 'createdAt'])
        && request.resource.data.authorUid == request.auth.uid
        && request.resource.data.createdAt == request.time
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0
        && request.resource.data.text.size() <= 2000;
    }
  }
}
